<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="ApiGate">
            <directory>tests/ApiGate</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- runningUnitTests() keys off this; lfl:install prompts otherwise. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <!-- The suite builds its own in-memory SQLite connection; forced here too
             (both $_ENV and $_SERVER) so nothing can ever reach a real database. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <!-- No provider keys, ever, in a test run. -->
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="" force="true"/>
        <server name="OPENAI_API_KEY" value="" force="true"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>


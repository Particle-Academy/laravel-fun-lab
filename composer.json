{
    "name": "particle-academy/laravel-fun-lab",
    "description": "Analytics-driven gamification layer for Laravel applications. Track user engagement through awards, achievements, and prizes.",
    "type": "library",
    "keywords": [
        "laravel",
        "gamification",
        "analytics",
        "engagement",
        "achievements",
        "awards",
        "prizes",
        "leaderboards"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Particle Academy",
            "email": "dev@particleacademy.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel/framework": "^13.0",
        "symfony/yaml": "^6.4.50|^7.4.23|^8.1.11"
    },
    "replace": {
        "particleacademy/laravel-fun-lab": "self.version"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "particle-academy/fancy-conformance": "0.50.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelFunLab\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelFunLab\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelFunLab\\LFLServiceProvider"
            ],
            "aliases": {
                "LFL": "LaravelFunLab\\Facades\\LFL"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
